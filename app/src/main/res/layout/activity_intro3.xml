<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="24dp">

    <!-- Coffee Image -->
    <ImageView
        android:id="@+id/ivCoffeeImage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="40dp"
        android:src="@drawable/coffee_intro_image"
        android:scaleType="centerCrop"
        android:background="@drawable/rounded_image_background" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Biji Kopi Terbaik"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Description -->
    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dapatkan semua biji kopi favorit Anda di satu tempat, Anda tinggal memesan, kami yang mengerjakan sisanya"
        android:textSize="16sp"
        android:textColor="@color/gray_text"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="32dp" />

    <!-- Page Indicators -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_marginBottom="40dp">

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/indicator_inactive"
            android:layout_marginEnd="8dp" />

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/indicator_inactive"
            android:layout_marginEnd="8dp" />

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/indicator_active"
            android:layout_marginEnd="8dp" />

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/indicator_inactive" />

    </LinearLayout>

    <!-- Continue Button -->
    <Button
        android:id="@+id/btnLanjut"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="LANJUT"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/button_brown_background"
        android:layout_marginBottom="16dp" />

    <!-- Skip Text -->
    <TextView
        android:id="@+id/tvLewati"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lewati"
        android:textSize="16sp"
        android:textColor="@color/gray_text"
        android:layout_gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp" />

</LinearLayout>